{
  "name": "@stock-ex/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "NestJS game server: rooms, sockets, timers and persistence.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/throttler": "6.7.1",
    "@stock-ex/db": "workspace:*",
    "@stock-ex/shared": "workspace:*",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@stock-ex/config": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
