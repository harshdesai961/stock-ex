# Throwaway values for CI only. They protect nothing (CI databases are disposable)
# and exist so the Zod env validation passes. CI jobs copy this file to .env.
POSTGRES_USER=stockex
POSTGRES_PASSWORD=ci-only-postgres-password
POSTGRES_DB=stockex_ci
REDIS_PASSWORD=ci-only-redis-password
APP_DB_USER=stockex_app
APP_DB_PASSWORD=ci-only-app-db-password
DATABASE_URL=postgresql://stockex_app:ci-only-app-db-password@localhost:5432/stockex_ci
DATABASE_MIGRATION_URL=postgresql://stockex:ci-only-postgres-password@localhost:5432/stockex_ci
REDIS_URL=redis://:ci-only-redis-password@localhost:6379
WEB_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
BETTER_AUTH_SECRET=ci-only-not-a-secret-ci-only-not-a-secret-ci
SOCKET_TOKEN_SECRET=ci-only-not-a-secret-ci-only-not-a-secret-ci
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
FEATURE_AI=false
