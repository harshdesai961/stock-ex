# stock-ex local development settings.
# Copy to .env (git-ignored) and change every value marked CHANGE-ME, or just run
# `pnpm bootstrap`, which creates .env and fills in random secrets for you.
# This root .env is the only env file a developer edits; all apps read it.
# Adding a variable? Also add it to packages/shared/src/env/schema.ts and docs/DEVELOPMENT.md.

NODE_ENV=development
LOG_LEVEL=info

# --- Docker services (docker-compose.yml) ---
POSTGRES_USER=stockex
POSTGRES_PASSWORD=CHANGE-ME-local-only
POSTGRES_DB=stockex_dev
REDIS_PASSWORD=CHANGE-ME-local-only

# --- Database roles (spec section 7) ---
# Least-privilege role the apps connect as: read/write data, no DDL. Created by `pnpm bootstrap`.
APP_DB_USER=stockex_app
APP_DB_PASSWORD=CHANGE-ME-local-only
# Apps connect as the app role. Must match APP_DB_USER / APP_DB_PASSWORD above.
DATABASE_URL=postgresql://stockex_app:CHANGE-ME-local-only@localhost:5432/stockex_dev
# Migrations and drizzle-kit connect as the owner role (POSTGRES_USER / POSTGRES_PASSWORD above).
DATABASE_MIGRATION_URL=postgresql://stockex:CHANGE-ME-local-only@localhost:5432/stockex_dev
REDIS_URL=redis://:CHANGE-ME-local-only@localhost:6379

# --- App URLs and ports ---
WEB_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
SERVER_HOST=127.0.0.1
SERVER_PORT=4000
# Set to true only behind a known reverse proxy (Cloudflare, the host's load balancer).
TRUST_PROXY=false
# Live room keys in Redis expire after this many idle seconds (6 hours).
ROOM_TTL_SECONDS=21600

# --- Secrets (generate your own; see docs/DEVELOPMENT.md section 4.3) ---
BETTER_AUTH_SECRET=CHANGE-ME-generate-32-random-bytes
SOCKET_TOKEN_SECRET=CHANGE-ME-generate-32-random-bytes

# --- Optional third-party services (the app runs locally without them) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
SENTRY_DSN=
# Cloudflare Turnstile official test keys (always pass; safe to commit)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Feature flags ---
FEATURE_AI=false
