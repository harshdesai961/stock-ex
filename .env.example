# stock-ex local development settings.
# Copy to .env (git-ignored) and change every value marked CHANGE-ME.
# This root .env is the only env file a developer edits; all apps read it.

# --- Docker services (docker-compose.yml) ---
POSTGRES_USER=stockex
POSTGRES_PASSWORD=CHANGE-ME-local-only
POSTGRES_DB=stockex_dev
REDIS_PASSWORD=CHANGE-ME-local-only

# --- Connection strings used by the apps (must match the values above) ---
DATABASE_URL=postgresql://stockex:CHANGE-ME-local-only@localhost:5432/stockex_dev
REDIS_URL=redis://:CHANGE-ME-local-only@localhost:6379

# --- App URLs and ports ---
WEB_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
SERVER_PORT=4000

# --- Secrets (generate your own; see docs/DEVELOPMENT.md section 4.3) ---
BETTER_AUTH_SECRET=CHANGE-ME-generate-32-random-bytes
SOCKET_TOKEN_SECRET=CHANGE-ME-generate-32-random-bytes

# --- Optional third-party services (the app runs locally without them) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
SENTRY_DSN=
# Cloudflare Turnstile official test keys (always pass; safe to commit)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Feature flags ---
FEATURE_AI=false
